{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tank-arena-lobby",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "GameLobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameLobby"] }
  ]
}
